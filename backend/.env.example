# Postgres connection string (Neon, same DB as deal_cloud_enhancer).
# The research schema is created by migrations/001_initial.sql; cross-schema
# reads against dealcloud.* are read-only and use the same connection.
DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# Anthropic API key for the chat agents (Sonnet for chat, Haiku for cheap subtasks).
ANTHROPIC_API_KEY=sk-ant-...

# Entra ID (Azure AD) -- shared tenant with org_history_viewer.
# Stubbed in V0; required when auth.py switches from header-trust to OAuth.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
FLASK_SECRET_KEY=

# CORS allowlist for the frontend dev server and the deployed Render web service.
# Comma-separated origins. Empty = allow none (locks the API down).
ALLOWED_ORIGINS=http://localhost:5173
